{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "fabric-skills",
  "description": "Complete bundle: all Microsoft Skills for Fabric for developers and consumers",
  "version": "0.3.15",
  "license": "MIT",
  "repository": "https://github.com/microsoft/skills-for-fabric",
  "keywords": [
    "fabric",
    "microsoft-fabric",
    "medallion",
    "data-warehouse",
    "sqldatabase",
    "lakehouse",
    "analytics",
    "kql",
    "kusto",
    "eventhouse",
    "real-time-intelligence"
  ],
  "skills": [
    "./skills/fabriciq",
    "./skills/semantic-model-authoring",
    "./skills/spark-cli",
    "./skills/sqldw-cli",
    "./skills/eventhouse-cli",
    "./skills/eventstream-cli",
    "./skills/eventschemaset-cli",
    "./skills/activator-cli",
    "./skills/sqldb-cli",
    "./skills/azmon-mirroredcatalogs-operations-cli",
    "./skills/dataflows-cli",
    "./skills/search-consumption-cli",
    "./skills/onelake-catalog-govern-cli",
    "./skills/fabriciq-ontology-cli",
    "./skills/variable-library-cli",
    "./skills/deployment-pipelines-authoring-cli",
    "./skills/databricks-migration",
    "./skills/pipeline-migration",
    "./skills/synapse-migration",
    "./skills/hdinsight-migration",
    "./skills/e2e-medallion-architecture",
    "./skills/git-integration-operations-cli",
    "./skills/e2e-fabric-cost-estimation"
  ],
  "agents": [
    "./agents/FabricAdmin.agent.md",
    "./agents/FabricDataEngineer.agent.md",
    "./agents/FabricAppDev.agent.md",
    "./agents/FabricIQ.agent.md"
  ],
  "mcpServers": {
    "FabricIQ": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/fabricaihub/integrations/m365",
      "headers": {
        "X-VARIANTS": "Fabric.Routing.PowerBIDataExploration"
      },
      "tools": [
        "*"
      ]
    },
    "powerbi-modeling-mcp": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/powerbi/authoring",
      "tools": [
        "*"
      ]
    },
    "fabric-sqlendpoint": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/dataPlane/sqlEndpoint",
      "tools": [
        "execute_query"
      ]
    }
  }
}
